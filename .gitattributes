# ==============================================================================
# Git 跨平台换行符自动归一化配置
# 强制所有文本文件统一使用 LF 换行符，杜绝 Windows CRLF 导致 Linux/CI 脚本崩溃
# ==============================================================================

# 默认自动检测文本并统一换行为 LF
* text=auto eol=lf

# 纯文本、脚本与配置文件强制 LF
.githooks/* text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.vue text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件声明
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.zip binary
*.tar.gz binary
*.tgz binary
*.exe binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
