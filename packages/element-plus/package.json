{
  "name": "@atengk/element-plus",
  "version": "0.1.0",
  "description": "面向现代 Web 应用与企业级系统的 Element Plus 基础设施增强组件库与指令集",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "element-plus": ">=2.8.0",
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@atengk/core": "workspace:*",
    "@atengk/vue": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "element-plus": "^2.14.7",
    "sass": "^1.106.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44"
  },
  "keywords": [
    "vue",
    "element-plus",
    "components",
    "directives",
    "table",
    "excel"
  ],
  "author": "atengk",
  "license": "Apache-2.0"
}
