{
  "name": "@atengk/element-plus",
  "version": "0.1.0",
  "description": "面向企业级管理系统的 Element Plus 基础设施增强组件库与指令集",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "element-plus": ">=2.8.0",
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@atengk/core": "workspace:*",
    "@atengk/vue": "workspace:*"
  },
  "devDependencies": {
    "element-plus": "^2.14.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vue": "^3.5.44"
  },
  "keywords": [
    "vue",
    "element-plus",
    "components",
    "directives",
    "table",
    "excel"
  ],
  "author": "atengk",
  "license": "Apache-2.0"
}
