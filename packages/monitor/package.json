{
  "name": "@atengk/monitor",
  "version": "0.1.0",
  "description": "面向现代 Web 应用与企业级系统的高可用纯 TypeScript 全链路可观测性与异常监控基础设施",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "monitor",
    "apm",
    "observability",
    "performance",
    "web-vitals",
    "white-screen",
    "tracing",
    "typescript"
  ],
  "author": "atengk",
  "license": "Apache-2.0"
}
