{
  "name": "@atengk/core",
  "version": "0.1.0",
  "description": "面向企业级架构的无框架纯 TypeScript 契约与工业级网络请求底座",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "core",
    "axios",
    "contract",
    "typescript",
    "result",
    "pagination"
  ],
  "author": "atengk",
  "license": "Apache-2.0"
}
