{
  "name": "@atengk/vue",
  "version": "0.1.0",
  "description": "面向现代 Web 应用的 Vue 3 响应式通用 Composables/Hooks 基础设施",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@atengk/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vue": "^3.5.44"
  },
  "keywords": [
    "vue",
    "composables",
    "hooks",
    "reactive",
    "request"
  ],
  "author": "atengk",
  "license": "Apache-2.0"
}
