{
  "name": "@atengk/ai-chat-vue",
  "version": "1.0.0",
  "description": "面向现代 Web 应用与大语言模型交互的企业级 AI 智能体对话、思考链折叠与 Artifacts 产物协同响应式扩展基础设施",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "mermaid": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "@atengk/core": "workspace:*",
    "@atengk/vue": "workspace:*",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
