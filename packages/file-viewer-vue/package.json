{
  "name": "@atengk/file-viewer-vue",
  "version": "0.1.0",
  "description": "面向现代 Web 应用与企业级系统的纯前端多格式文档与工程图纸浏览器原生离线渲染扩展套件",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:assets": "node scripts/sync-assets.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@atengk/core": "workspace:*",
    "@atengk/vue": "workspace:*",
    "@file-viewer/core": "^3.2.2",
    "@file-viewer/preset-office": "^3.2.2",
    "@file-viewer/renderer-text": "^3.2.2",
    "@file-viewer/vue3": "^3.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44"
  },
  "keywords": [
    "file-viewer",
    "document-viewer",
    "office",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "vue3",
    "ateng-ui"
  ],
  "author": "atengk",
  "license": "Apache-2.0"
}
