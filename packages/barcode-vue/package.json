{
  "name": "@atengk/barcode-vue",
  "version": "1.0.0",
  "description": "面向现代 Web 应用、仓储物流与智能制造的工业级条码、艺术二维码与动态扫码扩展基础设施",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@atengk/core": "workspace:*",
    "@atengk/vue": "workspace:*",
    "jsbarcode": "^3.11.6"
  },
  "devDependencies": {
    "@atengk/core": "workspace:*",
    "@atengk/vue": "workspace:*",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.13"
  }
}
